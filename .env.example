# Environment Variables
# Copy this file to .env and fill in your values

# Web build-time configuration
# VITE_ variables are embedded into the browser bundle by Vite during dev/build.
VITE_API_BASE_URL=
VITE_APP_NAME=Vite React shadcn Template

# Server Configuration
PORT=3000
NODE_ENV=development
# Enable Swagger UI at /swagger and OpenAPI JSON at /swagger/json.
# Disabled by default; enable only in trusted development environments.
DEBUG=false

# Database
DATABASE_URL=file:local.db

# Authentication
# Public authentication server URL (takes precedence over legacy BASE_URL).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Trusted frontend origin, including scheme and port. Defaults to localhost:5173
# outside production; set explicitly for a separate production frontend.
CLIENT_URL=http://localhost:5173

# API Keys (example)
# API_KEY=your_api_key_here
